# Tokenonomics configuration — copy this file to `tokenonomics.env` (never commit it).
# Every value here is instance-specific. Fill in your own values.
# Lines starting with # are comments. Values may not contain spaces.

# --- Paths ---
# Absolute path to this project directory (where you cloned it).
TOK_DIR=/path/to/Tokenonomics
# Where runtime state (spend data, cached values) is kept. Recommended: $TOK_DIR/state
TOK_STATE_DIR=$TOK_DIR/state
# Directory holding the logo PNGs (see assets/README.md).
TOK_ASSETS_DIR=$TOK_DIR/assets
# Path to the compiled pill renderer. Build it with:  swiftc -O -o $TOK_DIR/scripts/makeblob scripts/render_blob.swift
TOK_MAKEBLOB=$TOK_DIR/scripts/makeblob

# --- ESnet gateway (your LiteLLM proxy) ---
# Base URL of your gateway. The spend fetcher reads Prometheus metrics at <base>/metrics/.
ES_BASE_URL=https://your-gateway.example.com
# Your gateway account email, used to filter the per-user spend metrics series.
ES_SPEND_EMAIL=you@example.com
# Monthly budget shown in the menu (used for the "x / $500 mo" line).
ES_SPEND_BUDGET=500

# --- CBorg / LBL spend (optional; leave blank to disable) ---
CBORG_BASE_URL=https://api.cborg.example.com
# API key with spend-read scope. NEVER commit your real key.
CBORG_API_KEY=
CBORG_MAX_BUDGET=500

# --- VPN clients ---
# Viscosity connection name for your ESnet profile (as shown in the Viscosity menu).
VISC_CONNECTION_NAME=ESnet VPN West (split tunnel)
# IP used to check whether the ESnet tunnel is actually up (ping target).
ESNET_PING_TARGET=10.0.0.1
# Cisco Secure Client app bundle (LBL AnyConnect).
CISCO_APP_PATH=/Applications/Cisco/Cisco Secure Client.app
# Cisco profile/host name to connect (see: /opt/cisco/secureclient/bin/vpn hosts)
CISCO_PROFILE=LBL-MFA-VPN

# --- Logos (see assets/README.md for licensing notes) ---
LOGO_ESNET=$TOK_ASSETS_DIR/esnet_logo.png
LOGO_LBL=$TOK_ASSETS_DIR/lbl_logo.png
LOGO_CBORG=$TOK_ASSETS_DIR/cborg_logo.png
